services:
  makemkv:
    image: st0nefish/makemkv:latest
    container_name: makemkv
    restart: unless-stopped
    ports:
      - "5800:5800"  # Web GUI
      - "5900:5900"  # VNC (optional)
    environment:
      - USER_ID=1000
      - GROUP_ID=1000
      - TZ=America/New_York
      - KEEP_APP_RUNNING=1
      - ENABLE_CJK_FONT=0
      - INSTALL_EXTRA_PKGS=openjdk-11-jre-headless  # Java for BD-J support
      - MAKEMKV_KEY=${MAKEMKV_KEY}  # License key from .env file
      - DISPLAY_WIDTH=1280   # Adjust for your viewing preference
      - DISPLAY_HEIGHT=720   # Adjust for your viewing preference
      - NOTIFY_START=1  # Set to 0 to disable start notifications
      - CONTAINER_DEBUG=0  # Set to 1 for low-level debug logging
    volumes:
      - ./config:/config:rw  # Config directory - place apprise.yml here
      - /path/to/output:/output:rw  # Where ripped files will be saved
      - /dev/shm:/storage:rw  # RAM disk for temp files (optional, faster)
    devices:
      - /dev/sr0:/dev/sr0  # Your optical drive
      - /dev/sg3:/dev/sg3  # SCSI generic device (check with lsscsi)
    cap_add:
      - SYS_RAWIO  # Required for optical drive access
      - MKNOD